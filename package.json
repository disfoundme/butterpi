{
  "name": "butterpi",
  "version": "0.1.0",
  "description": "A fullscreen TUI for the pi coding agent — alt-screen transcript, live status HUD, timeline, toasts. Inspired by dsh-TUI.",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#dsh-ecosystem-spec/profile-definitions": "./vendor-stubs/dsh-ecosystem-spec/profile-definitions.js",
    "#dsh-ecosystem-spec/*": "./vendor-stubs/dsh-ecosystem-spec/profile-definitions.js"
  },
  "bin": {
    "butterpi": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test \"dist-test/test/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.3.1",
    "@deepseek-ai/cordis": "file:vendor-stubs/@deepseek-ai/cordis",
    "@deepseek-ai/dsh-agent": "file:vendor-stubs/@deepseek-ai/dsh-agent",
    "@deepseek-ai/dsh-agent-instructions": "file:vendor-stubs/@deepseek-ai/dsh-agent-instructions",
    "@deepseek-ai/dsh-atomic-write": "file:vendor-stubs/@deepseek-ai/dsh-atomic-write",
    "@deepseek-ai/dsh-commands": "file:vendor-stubs/@deepseek-ai/dsh-commands",
    "@deepseek-ai/dsh-invariants": "file:vendor-stubs/@deepseek-ai/dsh-invariants",
    "@deepseek-ai/dsh-llm": "file:vendor-stubs/@deepseek-ai/dsh-llm",
    "@deepseek-ai/dsh-session": "file:vendor-stubs/@deepseek-ai/dsh-session",
    "@deepseek-ai/dsh-session-persistence-jsonl": "file:vendor-stubs/@deepseek-ai/dsh-session-persistence-jsonl",
    "@deepseek-ai/dsh-skill": "file:vendor-stubs/@deepseek-ai/dsh-skill",
    "@deepseek-ai/dsh-system-prompt": "file:vendor-stubs/@deepseek-ai/dsh-system-prompt",
    "@deepseek-ai/dsh-user-questions": "file:vendor-stubs/@deepseek-ai/dsh-user-questions",
    "@deepseek-ai/dsh-workspace": "file:vendor-stubs/@deepseek-ai/dsh-workspace",
    "@deepseek-ai/schemastery": "file:vendor-stubs/@deepseek-ai/schemastery",
    "@dsh-std/command": "file:vendor-stubs/@dsh-std/command",
    "@dsh-std/core": "file:vendor-stubs/@dsh-std/core",
    "@dsh-std/manifest": "file:vendor-stubs/@dsh-std/manifest",
    "@dsh-std/messages": "file:vendor-stubs/@dsh-std/messages",
    "@dsh-std/presentation": "file:vendor-stubs/@dsh-std/presentation",
    "@dsh-std/storage": "file:vendor-stubs/@dsh-std/storage",
    "@earendil-works/pi-agent-core": "^0.87.1",
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "auto-bind": "^5.0.1",
    "bidi-js": "^1.1.0",
    "chalk": "^6.0.1",
    "cli-boxes": "^4.0.1",
    "cli-highlight": "^2.1.11",
    "code-excerpt": "^4.0.0",
    "diff": "^9.0.0",
